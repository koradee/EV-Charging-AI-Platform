# Use official lightweight Python image
FROM python:3.9-slim

# Set working directory inside container
WORKDIR /app

# Copy requirements file first (for caching layers)
COPY requirements.txt .

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy the entire project context
# We copy everything so we can access ev_charging_patterns.csv from root
COPY . .

# Expose port
EXPOSE 8000

# Command to run the application (gunicorn + uvicorn worker for production)
# Note: Since Dockerfile is at root, we run referencing backend module
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
