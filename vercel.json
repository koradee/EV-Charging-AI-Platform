{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm --prefix frontend ci && VITE_API_URL=/api npm --prefix frontend run build",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/node_modules/**,frontend/src/**,tests/**,docs/**,analytics/notebooks/**,analytics/reports/**,analytics/app/**,analytics/data/raw/**,analytics/data/processed/ev_charging_cleaned.csv,**/*.ipynb,**/__pycache__/**,.git/**,.venv/**}"
    }
  }
}
